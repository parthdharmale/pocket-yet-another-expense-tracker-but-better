# Server-only. Copy to .env.local; never rename secrets to NEXT_PUBLIC_*.
# Required: create YOUR OWN private Vercel Blob store and paste its token here.
BLOB_READ_WRITE_TOKEN=
# Required: your owner login email.
POCKET_OWNER_EMAIL=
# Generated by npm run setup; do not hand-pick or share these values.
POCKET_PASSWORD_HASH=
POCKET_SESSION_SECRET=
# Your deployment origin for personalised iPhone shortcut instructions.
# Use https://your-project.vercel.app after deployment; no trailing path.
POCKET_PUBLIC_URL=http://localhost:3000
# Optional. Leave blank to use manual entry and manual merchant categorisation.
OPENAI_API_KEY=
OPENAI_ENTRY_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_RESEARCH_MODEL=gpt-4.1-mini
